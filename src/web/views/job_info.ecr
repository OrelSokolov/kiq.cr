<section>
  <header>
    <h1><%= t("Job") %></h1>
  </header>

  <div class="table_container">
    <table>
      <tbody>
        <tr>
          <th><%= t("Queue") %></th>
          <td>
            <a href="<%= root_path %>queues/<%= Web.escape(job.queue) %>"><%= h(job.queue) %></a>
          </td>
        </tr>
        <tr>
          <th><%= t("Job") %></th>
          <td>
            <%= job.display_class %>
            <%= display_tags(job.tags) %>
          </td>
        </tr>
        <tr>
          <th><%= t("Arguments") %></th>
          <td>
            <code class="code-wrap">
              <!-- We don't want to truncate any job arguments when viewing a single job's status page -->
              <div class="args-extended"><%= display_args(job.display_args, nil) %></div>
            </code>
          </td>
        </tr>
        <tr>
          <th>JID</th>
          <td>
            <code><%= job.jid %></code>
          </td>
        </tr>
        <tr>
          <th><%= t("CreatedAt") %></th>
          <td><%= relative_time(time_from_any(job["created_at"]?) || Time.utc) %></td>
        </tr>
        <tr>
          <th><%= t("Enqueued") %></th>
          <td><%= (e = time_from_any(job["enqueued_at"]?)) ? relative_time(e) : t("NotYetEnqueued") %></td>
        </tr>
        <% unless retry_extra_items.empty? %>
          <tr>
            <th><%= t("Extras") %></th>
            <td>
              <code>
                <%= retry_extra_items.map { |k, v| "#{k} => #{v}" }.join(", ") %>
              </code>
            </td>
          </tr>
        <% end %>
        <% if type == :retry %>
          <% if (rc = retry_count) && rc > 0 %>
            <tr>
              <th><%= t("RetryCount") %></th>
              <td><%= job["retry_count"] %></td>
            </tr>
            <tr>
              <th><%= t("LastRetry") %></th>
              <td><%= relative_time(time_from_any(job["retried_at"]?) || Time.utc) %></td>
            </tr>
          <% else %>
            <tr>
              <th><%= t("OriginallyFailed") %></th>
              <td><%= relative_time(time_from_any(job["failed_at"]?) || Time.utc) %></td>
            </tr>
          <% end %>
          <tr>
            <th><%= t("NextRetry") %></th>
            <td><%= relative_time(job.at) %></td>
          </tr>
        <% end %>
        <% if type == :scheduled %>
          <tr>
            <th><%= t("Scheduled") %></th>
            <td><%= relative_time(job.at) %></td>
          </tr>
        <% end %>
        <% if type == :dead %>
          <tr>
            <th><%= t("LastRetry") %></th>
            <td><%= relative_time(job.at) if retry_count %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</section>
