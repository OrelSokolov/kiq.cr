<%= Views::JobInfo.new(ctx, @job, :retry).to_s %>

<section>
  <header>
    <h2><%= t("Error") %></h2>
  </header>

  <div class="table_container">
    <table>
      <tbody>
        <tr>
          <th><%= t("ErrorClass") %></th>
          <td>
            <code><%= h(@job["error_class"].to_s) %></code>
          </td>
        </tr>
        <tr>
          <th><%= t("ErrorMessage") %></th>
          <td><%= h(@job["error_message"].to_s) %></td>
        </tr>
      </tbody>
    </table>
  </div>

  <form action="<%= root_path %>retries/<%= job_params(@job) %>" method="post">
    <%= csrf_tag %>
    <a class="btn btn-default" href="<%= root_path %>retries"><%= t("GoBack") %></a>
    <input class="btn btn-primary" type="submit" name="retry" value="<%= t("RetryNow") %>">
    <input class="btn btn-danger" type="submit" name="delete" value="<%= t("Delete") %>">
  </form>
</section>
